<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/screen_padding">

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/tvAgentLogHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/agent_log_title"
        android:textAppearance="@style/TextAppearance.SocialAgent.Headline" />

    <com.google.android.material.textview.MaterialTextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/component_spacing_xsmall"
        android:text="@string/agent_log_subtitle"
        android:textAppearance="@style/TextAppearance.SocialAgent.Caption" />

    <RadioGroup
        android:id="@+id/rgChannelFilter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/component_spacing_small"
        android:orientation="horizontal">

        <com.lttbdd.socialagent.core.ui.components.StyledRadioButton
            android:id="@+id/rbFilterAll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/agent_log_filter_all" />

        <com.lttbdd.socialagent.core.ui.components.StyledRadioButton
            android:id="@+id/rbFilterFacebook"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/component_spacing_small"
            android:text="@string/compose_channel_facebook" />

        <com.lttbdd.socialagent.core.ui.components.StyledRadioButton
            android:id="@+id/rbFilterLinkedIn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/component_spacing_small"
            android:text="@string/compose_channel_linkedin" />
    </RadioGroup>

    <com.lttbdd.socialagent.core.ui.components.OutlinedButton
        android:id="@+id/btnClearLogs"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/component_spacing_small"
        android:enabled="false"
        android:text="@string/agent_log_action_clear" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/component_spacing"
        android:layout_weight="1">

        <com.lttbdd.socialagent.core.ui.components.AppLoading
            android:id="@+id/loadingIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminate="true" />

        <com.lttbdd.socialagent.core.ui.components.AppEmptyState
            android:id="@+id/emptyState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvAgentLogs"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/component_spacing_large"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
