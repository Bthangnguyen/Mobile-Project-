<?xml version="1.0" encoding="utf-8"?>
<com.lttbdd.socialagent.core.ui.components.AppCard xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/component_spacing">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvVersionNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.SocialAgent.Title" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvVersionSource"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/component_spacing_small"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.SocialAgent.Caption" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/tvCurrentBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/history_current_version_badge"
                android:textAppearance="@style/TextAppearance.SocialAgent.Caption"
                android:textColor="@color/brand_success"
                android:visibility="gone" />
        </LinearLayout>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvVersionMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/component_spacing_xsmall"
            android:textAppearance="@style/TextAppearance.SocialAgent.Caption" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/tvVersionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/component_spacing_small"
            android:ellipsize="end"
            android:maxLines="5"
            android:textAppearance="@style/TextAppearance.SocialAgent.Body" />

        <com.lttbdd.socialagent.core.ui.components.OutlinedButton
            android:id="@+id/btnRestoreVersion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/component_spacing"
            android:text="@string/history_action_restore" />
    </LinearLayout>
</com.lttbdd.socialagent.core.ui.components.AppCard>
